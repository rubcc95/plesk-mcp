{
  "name": "@rubcc95/plesk-mcp",
  "version": "0.1.0",
  "description": "MCP server for Plesk: files, composer, Node.js, logs and SQL databases",
  "type": "module",
  "license": "MIT",
  "author": "rubcc95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubcc95/plesk-mcp.git"
  },
  "homepage": "https://github.com/rubcc95/plesk-mcp#readme",
  "bugs": {
    "url": "https://github.com/rubcc95/plesk-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "plesk",
    "plesk-api",
    "mysql",
    "nodejs",
    "files",
    "deployment"
  ],
  "bin": {
    "plesk-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "mysql2": "^3.24.6",
    "node-sql-parser": "^5.4.0",
    "picomatch": "^4.0.7",
    "tar": "^7.5.22",
    "undici": "^7.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/picomatch": "^4.0.2",
    "tsup": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
